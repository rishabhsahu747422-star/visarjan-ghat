# Copy to backend/.env for local runs. NEVER commit real keys.
ALLOWED_ORIGINS=http://localhost:5173
# Optional LLM layer (brief + reasons). The app works without these using the template fallback.
# LLM_PROVIDER: groq | none
LLM_PROVIDER=none
GROQ_API_KEY=
# Optional: any open-weight model on Groq, e.g. llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
